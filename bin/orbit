#!/usr/bin/env bash
# orbit - a 3D planet app launcher for Wayland (quickshell based)
#
#   orbit               toggle (talks to the daemon if one runs, else a one-shot launcher)
#   orbit daemon        stay resident for an instant open (launcher UI is unloaded while hidden)
#   orbit open|close    explicit open / close (daemon)
#   orbit reload        re-read orbit.conf and the theme file (daemon)
#   orbit kill          stop the daemon
#   orbit init [-f]     write ~/.config/orbit/orbit.conf and copy the planets next to it
#   orbit planets       list the planets orbit can find
#   orbit import-caelestia   seed launch history from caelestia's apps.sqlite
#   orbit doctor        check dependencies and config
#
# Options (before the command):  -c, --config FILE   use another orbit.conf

set -euo pipefail

VERSION="1.0.0"

# Where the QML lives: next to this script in a checkout, else the install prefix
self="$(readlink -f "${BASH_SOURCE[0]}")"
here="$(dirname "$self")"
if [[ -n "${ORBIT_SHARE:-}" ]]; then
    share="$ORBIT_SHARE"
elif [[ -f "$here/../standalone/shell.qml" ]]; then
    share="$(readlink -f "$here/../standalone")"
elif [[ -f "$here/../share/orbit/shell.qml" ]]; then
    share="$(readlink -f "$here/../share/orbit")"
else
    share="/usr/share/orbit"
fi

config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
config_dir="$config_home/orbit"
config="${ORBIT_CONFIG:-$config_dir/orbit.conf}"

die() { printf 'orbit: %s\n' "$*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
    case "$1" in
        -c|--config) [[ $# -ge 2 ]] || die "$1 needs a file"; config="$(readlink -f "$2")"; shift 2 ;;
        -h|--help) sed -n '2,17p' "$self" | sed 's/^# \{0,1\}//'; exit 0 ;;
        -v|--version) echo "orbit $VERSION"; exit 0 ;;
        *) break ;;
    esac
done
cmd="${1:-toggle}"
[[ $# -gt 0 ]] && shift

command -v qs >/dev/null 2>&1 || die "quickshell (qs) is not installed - see https://quickshell.org"
[[ -f "$share/shell.qml" ]] || die "cannot find orbit's QML files (looked in $share)"

# The bundled planets: inside the Orbit module next to shell.qml
bundled_planets="$(readlink -f "$share/Orbit/planets")"

# Read one key from orbit.conf (last one wins, quotes and trailing comments stripped)
conf_get() {
    [[ -f "$config" ]] || return 0
    sed -n -E "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*//p" "$config" | tail -n1 \
        | sed -E 's/[[:space:]]+#.*$//; s/^"(.*)"$/\1/; s/^'"'"'(.*)'"'"'$/\1/; s/[[:space:]]+$//'
}

# Icon theme: orbit.conf, then the environment, then whatever the desktop is set to
detect_icon_theme() {
    local t
    t="$(conf_get icon_theme)"
    [[ -n "$t" ]] && { echo "$t"; return; }
    [[ -n "${QS_ICON_THEME:-}" ]] && { echo "$QS_ICON_THEME"; return; }
    for f in "$config_home/qt6ct/qt6ct.conf" "$config_home/qt5ct/qt5ct.conf"; do
        t="$(sed -n -E 's/^icon_theme=(.*)$/\1/p' "$f" 2>/dev/null | head -n1)"
        [[ -n "$t" ]] && { echo "$t"; return; }
    done
    t="$(sed -n -E '/^\[Icons\]/,/^\[/ s/^Theme=(.*)$/\1/p' "$config_home/kdeglobals" 2>/dev/null | head -n1)"
    [[ -n "$t" ]] && { echo "$t"; return; }
    if command -v gsettings >/dev/null 2>&1; then
        t="$(gsettings get org.gnome.desktop.interface icon-theme 2>/dev/null | tr -d "'")"
        [[ -n "$t" && "$t" != "hicolor" ]] && { echo "$t"; return; }
    fi
    t="$(sed -n -E 's/^gtk-icon-theme-name[[:space:]]*=[[:space:]]*"?([^"]*)"?$/\1/p' "$config_home/gtk-3.0/settings.ini" 2>/dev/null | head -n1)"
    [[ -n "$t" ]] && { echo "$t"; return; }
    for t in Papirus-Dark Papirus breeze-dark breeze Adwaita; do
        [[ -d "/usr/share/icons/$t" || -d "$HOME/.local/share/icons/$t" ]] && { echo "$t"; return; }
    done
    echo hicolor
}

# Daemon instance: the qs instance started from our shell.qml with ORBIT_DAEMON
daemon_running() {
    qs ipc -p "$share" call orbit isOpen >/dev/null 2>&1
}

ipc() {
    qs ipc -p "$share" call orbit "$@"
}

run_qs() {
    # $1 = oneshot flag; remaining args go to qs
    local oneshot="$1"; shift
    local theme renderer
    theme="$(detect_icon_theme)"
    renderer="$(conf_get renderer)"
    # software: no GPU context at all, ~45 MB less RAM, a little more CPU
    if [[ "$renderer" == "software" ]]; then
        export QT_QUICK_BACKEND=software
    fi
    ORBIT_CONFIG="$config" ORBIT_ONESHOT="$oneshot" QS_ICON_THEME="$theme" \
        exec qs -p "$share" -n "$@"
}

init_config() {
    local force="${1:-}"
    mkdir -p "$config_dir"
    if [[ -f "$config_dir/orbit.conf" && "$force" != "-f" ]]; then
        echo "orbit: $config_dir/orbit.conf already exists (use 'orbit init -f' to overwrite)"
    else
        [[ -f "$config_dir/orbit.conf" ]] && cp "$config_dir/orbit.conf" "$config_dir/orbit.conf.bak-$(date +%F-%H%M%S)"
        sed "s#^planets_dir[[:space:]]*=.*#planets_dir = $config_dir/planets#" "$share/orbit.conf" > "$config_dir/orbit.conf"
        echo "orbit: wrote $config_dir/orbit.conf"
    fi
    mkdir -p "$config_dir/planets"
    local n=0
    for p in "$bundled_planets"/*; do
        [[ -e "$config_dir/planets/$(basename "$p")" ]] && continue
        cp "$p" "$config_dir/planets/"
        n=$((n + 1))
    done
    echo "orbit: copied $n planet(s) to $config_dir/planets"
}

# First run of the standalone launcher: give the user their own config + planets
ensure_config() {
    if [[ -z "${ORBIT_CONFIG:-}" && "$config" == "$config_dir/orbit.conf" && ! -f "$config" ]]; then
        init_config >/dev/null
    fi
}

case "$cmd" in
    toggle)
        if daemon_running; then ipc toggle >/dev/null; else ensure_config; run_qs 1; fi ;;
    open)
        if daemon_running; then ipc open >/dev/null; else ensure_config; run_qs 1; fi ;;
    close)
        if daemon_running; then ipc close >/dev/null; else qs kill -p "$share" >/dev/null 2>&1 || true; fi ;;
    daemon)
        daemon_running && die "a daemon is already running"
        ensure_config
        if [[ "${1:-}" == "--foreground" || "${1:-}" == "-F" ]]; then run_qs 0; else run_qs 0 -d; fi ;;
    reload)
        daemon_running || die "no daemon running"; ipc reload >/dev/null ;;
    kill|quit|stop)
        qs kill -p "$share" >/dev/null 2>&1 && echo "orbit: stopped" || echo "orbit: not running" ;;
    init)
        init_config "${1:-}" ;;
    planets)
        dir="$(conf_get planets_dir)"; dir="${dir/#\~/$HOME}"; dir="${dir:-$bundled_planets}"
        echo "planets in $dir:"
        for p in "$dir"/*.{png,jpg,jpeg,webp,svg}; do [[ -e "$p" ]] && echo "  $(basename "${p%.*}")"; done
        echo "  auto     (follows the theme's key colour)"
        echo "  random   (a new one each time it opens)" ;;
    import-caelestia)
        db="${XDG_STATE_HOME:-$HOME/.local/state}/caelestia/apps.sqlite"
        [[ -f "$db" ]] || die "no caelestia history at $db"
        command -v sqlite3 >/dev/null 2>&1 || die "sqlite3 is needed for this"
        state="$(conf_get state_dir)"; state="${state/#\~/$HOME}"
        state="${state:-${XDG_STATE_HOME:-$HOME/.local/state}/orbit}"
        mkdir -p "$state"
        table="$(sqlite3 "$db" "SELECT name FROM sqlite_master WHERE type='table' LIMIT 1;")"
        sqlite3 -json "$db" "SELECT id, frequency FROM \"$table\";" \
            | python3 -c 'import json,sys; print(json.dumps({r["id"]: r["frequency"] for r in json.load(sys.stdin) if r.get("frequency")}))' \
            > "$state/history.json.tmp"
        mv "$state/history.json.tmp" "$state/history.json"
        echo "orbit: imported $(grep -o ':' "$state/history.json" | wc -l) app(s) into $state/history.json" ;;
    doctor)
        ok() { printf '  \e[32mok\e[0m  %s\n' "$*"; }
        bad() { printf '  \e[31m!!\e[0m  %s\n' "$*"; }
        echo "orbit $VERSION"
        ok "quickshell: $(qs --version 2>/dev/null | head -n1)"
        ok "QML files: $share"
        [[ -f "$config" ]] && ok "config: $config" || bad "config: $config missing (run 'orbit init')"
        ok "icon theme: $(detect_icon_theme)"
        fc-list 2>/dev/null | grep -q "Material Symbols Rounded" && ok "font: Material Symbols Rounded" || echo "  --  Material Symbols Rounded not installed (built-in icons used)"
        [[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]] && ok "compositor: Hyprland (click-outside-to-close on)" || echo "  --  not Hyprland: Esc or a backdrop closes the launcher"
        daemon_running && ok "daemon: running" || echo "  --  daemon: not running (one-shot mode)" ;;
    *)
        die "unknown command '$cmd' (see orbit --help)" ;;
esac
